--// MenuLibRetro.lua
--// Flat dark / crimson menu library: top tabs, boxed groups, checkbox toggles,
--// slim sliders, dropdowns, buttons, labels and a watermark bar.
--//
--//   local Library = loadstring(game:HttpGet("https://your-url/MenuLibRetro.lua"))()

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- Swap these to change the whole look
local FONT = Enum.Font.BuilderSans
local BOLD_FONT = Enum.Font.BuilderSansBold
local TEXT_SIZE = 14

local THEME = {
	Window = Color3.fromRGB(13, 13, 13),
	Border = Color3.fromRGB(46, 46, 46),
	Panel = Color3.fromRGB(17, 17, 17),
	PanelBorder = Color3.fromRGB(38, 38, 38),
	Box = Color3.fromRGB(26, 26, 26),
	BoxHover = Color3.fromRGB(34, 34, 34),
	BoxBorder = Color3.fromRGB(0, 0, 0),
	Accent = Color3.fromRGB(40, 120, 230),
	Text = Color3.fromRGB(215, 215, 215),
	TextBright = Color3.fromRGB(240, 240, 240),
	TextDim = Color3.fromRGB(115, 115, 115),
	TextOff = Color3.fromRGB(70, 70, 70),
}

--------------------------------------------------------------------------------
-- helpers
--------------------------------------------------------------------------------

local function create(class, props, children)
	local inst = Instance.new(class)
	local parent = props.Parent
	props.Parent = nil
	for key, value in pairs(props) do
		inst[key] = value
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	inst.Parent = parent
	return inst
end

local function stroke(color, thickness)
	return create("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

local function padding(top, bottom, left, right)
	return create("UIPadding", {
		PaddingTop = UDim.new(0, top),
		PaddingBottom = UDim.new(0, bottom),
		PaddingLeft = UDim.new(0, left),
		PaddingRight = UDim.new(0, right),
	})
end

local function text(props)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.Font = props.Font or FONT
	props.TextSize = props.TextSize or TEXT_SIZE
	props.TextColor3 = props.TextColor3 or THEME.Text
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return create("TextLabel", props)
end

local function mountGui(gui)
	local candidates = {
		function() return gethui and gethui() end,
		function() return game:GetService("CoreGui") end,
		function() return Players.LocalPlayer:WaitForChild("PlayerGui") end,
	}
	for _, getTarget in ipairs(candidates) do
		local ok, target = pcall(getTarget)
		if ok and target then
			local parented = pcall(function()
				gui.Parent = target
			end)
			if parented and gui.Parent == target then
				return
			end
		end
	end
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch
end

local function isMove(input)
	return input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch
end

local function nextOrder(group)
	group._order = (group._order or 0) + 1
	return group._order
end

local function elementFrame(group, height)
	return create("Frame", {
		Size = UDim2.new(1, 0, 0, height),
		BackgroundTransparency = 1,
		LayoutOrder = nextOrder(group),
		Parent = group.Body,
	})
end

