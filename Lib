-- Library.new("name<a>xx</a> | uid 1337", Enum.KeyCode.RightShift, Color3.fromRGB(190, 20, 60))
-- Text between <a></a> is drawn in the accent color. Key and accent are optional.
function Library.new(title, toggleKey, accent)
	if accent then
		THEME.Accent = accent
	end

	local self = setmetatable({}, Library)
	self.Tabs = {}
	self.ActiveTab = nil
	self._connections = {}
	self._toggleKey = toggleKey or Enum.KeyCode.RightShift

	self.Gui = create("ScreenGui", {
		Name = "MenuLib_" .. tostring(math.random(1000, 9999)),
		ResetOnSpawn = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	})
	mountGui(self.Gui)

self.Main = create("Frame", {
    Name = "Main",
    Size = UDim2.fromOffset(400, 440),
    Position = UDim2.new(0.5, -200, 0.5, -220),
    BackgroundColor3 = THEME.Window,
    BorderSizePixel = 0,
    Parent = self.Gui,
}, { stroke(Color3.new(1, 1, 1), 2) })
local richTitle = (tostring(title or "menu")
    :gsub("<a>", '<font color="#' .. THEME.Accent:ToHex() .. '">')
    :gsub("</a>", "</font>"))

	local topbar = create("Frame", {
		Name = "Topbar",
		Size = UDim2.new(1, 0, 0, 28),
		BackgroundTransparency = 1,
		Parent = self.Main,
	})

	text({
		Text = richTitle,
		RichText = true,
		Font = BOLD_FONT,
		TextColor3 = THEME.TextBright,
		Size = UDim2.new(1, -20, 1, 0),
		Position = UDim2.fromOffset(10, 0),
		Parent = topbar,
	})

	self.TabBar = create("Frame", {
		Name = "TabBar",
		Size = UDim2.new(1, -16, 0, 24),
		Position = UDim2.fromOffset(8, 28),
		BackgroundTransparency = 1,
		Parent = self.Main,
	})

	create("Frame", {
		Size = UDim2.new(1, -16, 0, 1),
		Position = UDim2.fromOffset(8, 52),
		BackgroundColor3 = THEME.Border,
		BorderSizePixel = 0,
		Parent = self.Main,
	})

	self.Content = create("Frame", {
		Name = "Content",
		Size = UDim2.new(1, 0, 1, -54),
		Position = UDim2.fromOffset(0, 54),
		BackgroundTransparency = 1,
		Parent = self.Main,
	})

	-- drag by the title bar
	local dragging, dragStart, startPos = false, nil, nil
	table.insert(self._connections, topbar.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			dragStart = input.Position
			startPos = self.Main.Position
		end
	end))
	table.insert(self._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			local delta = input.Position - dragStart
			self.Main.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end))
	table.insert(self._connections, UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			dragging = false
		end
	end))

	-- show / hide hotkey
	table.insert(self._connections, UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == self._toggleKey then
			self.Main.Visible = not self.Main.Visible
		end
	end))

	return self
end

local function makeColumn(parent, side)
	return create("ScrollingFrame", {
		Size = UDim2.new(0.5, -13, 1, -16),
		Position = side == "left" and UDim2.new(0, 8, 0, 8) or UDim2.new(0.5, 5, 0, 8),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 2,
		ScrollBarImageColor3 = THEME.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Parent = parent,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
		-- room for group titles that sit on the top border
		create("UIPadding", { PaddingTop = UDim.new(0, 9), PaddingBottom = UDim.new(0, 4) }),
	})
end

function Library:Tab(name)
	local tab = setmetatable({}, Tab)
	tab.Window = self
	tab._counts = { left = 0, right = 0 }

	tab.Button = create("TextButton", {
		Name = name,
		BackgroundTransparency = 1,
		Text = name,
		TextColor3 = THEME.TextDim,
		Font = FONT,
		TextSize = TEXT_SIZE,
		AutoButtonColor = false,
		Parent = self.TabBar,
	})

	tab.Underline = create("Frame", {
		Size = UDim2.new(1, -12, 0, 2),
		Position = UDim2.new(0, 6, 1, -2),
		BackgroundColor3 = THEME.Accent,
		BorderSizePixel = 0,
		Visible = false,
		Parent = tab.Button,
	})

	tab.Page = create("Frame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = self.Content,
	})
	tab.Columns = {
		left = makeColumn(tab.Page, "left"),
		right = makeColumn(tab.Page, "right"),
	}

	table.insert(self.Tabs, tab)

	-- spread the tab buttons evenly across the bar
	local count = #self.Tabs
	for index, t in ipairs(self.Tabs) do
		t.Button.Size = UDim2.new(1 / count, 0, 1, 0)
		t.Button.Position = UDim2.new((index - 1) / count, 0, 0, 0)
	end

	tab.Button.MouseButton1Click:Connect(function()
		self:SelectTab(tab)
	end)
	if not self.ActiveTab then
		self:SelectTab(tab)
	end
	return tab
end

function Library:SelectTab(tab)
	for _, t in ipairs(self.Tabs) do
		local active = (t == tab)
		t.Page.Visible = active
		t.Underline.Visible = active
		t.Button.TextColor3 = active and THEME.TextBright or THEME.TextDim
	end
	self.ActiveTab = tab
end

function Library:_defaultTab()
	if not self._default then
		self._default = self:Tab("Main")
	end
	return self._default
end

function Library:Destroy()
	for _, connection in ipairs(self._connections) do
		connection:Disconnect()
	end
	self._connections = {}
	if self.Gui then
		self.Gui:Destroy()
	end
end

-- Window:Watermark({ "name", function() return "fps:" .. Library.FPS() end, "build:beta" })
-- Parts can be strings or functions returning strings; they refresh 4 times a second.
function Library:Watermark(parts, position)
	local box = create("Frame", {
		Name = "Watermark",
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = position or UDim2.fromOffset(14, 14),
		BackgroundColor3 = THEME.Window,
		BorderSizePixel = 0,
		Parent = self.Gui,
	}, { stroke(THEME.Border, 1), padding(0, 0, 8, 8) })

	create("Frame", {
		Size = UDim2.new(1, 16, 0, 1),
		Position = UDim2.fromOffset(-8, 0),
		BackgroundColor3 = THEME.Accent,
		BorderSizePixel = 0,
		Parent = box,
	})

	local label = text({
		RichText = true,
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		TextColor3 = THEME.Text,
		Parent = box,
	})

	local separator = string.format(' <font color="#%s">/</font> ', THEME.Accent:ToHex())
	local function refresh()
		local out = {}
		for _, part in ipairs(parts) do
			local value = part
			if type(part) == "function" then
				local ok, result = pcall(part)
				value = ok and result or "?"
			end
			table.insert(out, tostring(value))
		end
		label.Text = table.concat(out, separator)
	end

	refresh()
	task.spawn(function()
		while box.Parent do
			refresh()
			task.wait(0.25)
		end
	end)

	return box
end

