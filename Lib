-- Group:Toggle("Name", defaultState, function(enabled) ... end)
-- Group:Toggle("Name", function(enabled) ... end)
-- Returns: :Set(bool) :Get() :SetDisabled(bool) :Bind(Enum.KeyCode | nil)
function Group:Toggle(name, default, callback)
	if type(default) == "function" then
		callback, default = default, false
	end
	callback = callback or function() end
	local state = default and true or false
	local disabled = false
	local boundKey = nil

	local frame = elementFrame(self, 16)

	local box = create("Frame", {
		Size = UDim2.fromOffset(9, 9),
		Position = UDim2.fromOffset(0, 4),
		BackgroundColor3 = THEME.Box,
		BorderSizePixel = 0,
		Parent = frame,
	}, { stroke(THEME.BoxBorder, 1) })

	local label = text({
		Text = name,
		Size = UDim2.new(1, -50, 1, 0),
		Position = UDim2.fromOffset(16, 0),
		Parent = frame,
	})

	local tag = text({
		Text = "",
		Size = UDim2.fromOffset(40, 16),
		Position = UDim2.new(1, -40, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = THEME.TextDim,
		Parent = frame,
	})

	local hit = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		ZIndex = 3,
		Parent = frame,
	})

	local object = {}

	local function render()
		if disabled then
			box.BackgroundColor3 = THEME.Box
			label.TextColor3 = THEME.TextOff
		else
			box.BackgroundColor3 = state and THEME.Accent or THEME.Box
			label.TextColor3 = THEME.Text
		end
	end
	render()

	function object:Set(value, silent)
		state = value and true or false
		render()
		if not silent then
			task.spawn(callback, state)
		end
	end

	function object:Get()
		return state
	end

	function object:SetDisabled(value)
		disabled = value and true or false
		render()
	end

	function object:Bind(keyCode)
		boundKey = keyCode
		tag.Text = keyCode and ("[" .. keyCode.Name .. "]") or ""
	end

	hit.MouseButton1Click:Connect(function()
		if not disabled then
			object:Set(not state)
		end
	end)

	table.insert(self.Window._connections, UserInputService.InputBegan:Connect(function(input, processed)
		if boundKey and not processed and not disabled and input.KeyCode == boundKey then
			object:Set(not state)
		end
	end))

	return object
end

-- Group:Button("Name", function() ... end)
function Group:Button(name, callback)
	callback = callback or function() end

	local button = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundColor3 = THEME.Box,
		BorderSizePixel = 0,
		Text = name,
		TextColor3 = THEME.Text,
		Font = FONT,
		TextSize = TEXT_SIZE,
		AutoButtonColor = false,
		LayoutOrder = nextOrder(self),
		Parent = self.Body,
	}, { stroke(THEME.BoxBorder, 1) })

	button.MouseEnter:Connect(function()
		button.BackgroundColor3 = THEME.BoxHover
	end)
	button.MouseLeave:Connect(function()
		button.BackgroundColor3 = THEME.Box
	end)
	button.MouseButton1Click:Connect(function()
		task.spawn(callback)
	end)

	return button
end

-- Group:Slider("Name", min, max, default, function(value) ... end, step)
-- Returns: :Set(number) :Get()
function Group:Slider(name, min, max, default, callback, step)
	callback = callback or function() end
	step = step or 1
	local value = math.clamp(default or min, min, max)

	local frame = elementFrame(self, 28)

	text({
		Text = name,
		Size = UDim2.new(1, -50, 0, 14),
		Parent = frame,
	})

	local valueLabel = text({
		Text = tostring(value),
		Size = UDim2.fromOffset(50, 14),
		Position = UDim2.new(1, -50, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = THEME.TextDim,
		Parent = frame,
	})

	local bar = create("Frame", {
		Size = UDim2.new(1, 0, 0, 9),
		Position = UDim2.fromOffset(0, 17),
		BackgroundColor3 = THEME.Box,
		BorderSizePixel = 0,
		Parent = frame,
	}, { stroke(THEME.BoxBorder, 1) })

	local fill = create("Frame", {
		Size = UDim2.fromScale((value - min) / (max - min), 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = bar,
	}, {
		create("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(
				THEME.Accent:Lerp(Color3.new(1, 1, 1), 0.12),
				THEME.Accent:Lerp(Color3.new(0, 0, 0), 0.35)
			),
		}),
	})

	local hit = create("TextButton", {
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 12),
		BackgroundTransparency = 1,
		Text = "",
		Parent = frame,
	})

	local object = {}

	local function apply(raw, silent)
		local snapped = math.clamp(math.round(raw / step) * step, min, max)
		value = tonumber(string.format("%.4f", snapped))
		fill.Size = UDim2.fromScale((value - min) / (max - min), 1)
		valueLabel.Text = tostring(value)
		if not silent then
			task.spawn(callback, value)
		end
	end

	function object:Set(newValue, silent)
		apply(newValue, silent)
	end

	function object:Get()
		return value
	end

	local function fromInput(input)
		local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
		apply(min + (max - min) * alpha, false)
	end

	local dragging = false
	hit.InputBegan:Connect(function(input)
		if isPress(input) then
			dragging = true
			fromInput(input)
		end
	end)
	table.insert(self.Window._connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and isMove(input) then
			fromInput(input)
		end
	end))
	table.insert(self.Window._connections, UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			dragging = false
		end
	end))

	return object
end

-- Group:Dropdown("Name", { "A", "B", "C" }, "A", function(choice) ... end)
-- Returns: :Set(choice) :Get()
function Group:Dropdown(name, options, default, callback)
	callback = callback or function() end
	local selected = default or options[1]
	local open = false
	local rowHeight = 16

	local frame = elementFrame(self, 36)

	text({
		Text = name,
		Size = UDim2.new(1, 0, 0, 14),
		Parent = frame,
	})

	local box = create("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.fromOffset(0, 16),
		BackgroundColor3 = THEME.Box,
		BorderSizePixel = 0,
		Parent = frame,
	}, { stroke(THEME.BoxBorder, 1) })

	local valueLabel = text({
		Text = tostring(selected),
		Size = UDim2.new(1, -26, 1, 0),
		Position = UDim2.fromOffset(6, 0),
		TextColor3 = THEME.TextBright,
		Parent = box,
	})

	local plus = text({
		Text = "+",
		Size = UDim2.fromOffset(18, 18),
		Position = UDim2.new(1, -18, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = THEME.TextBright,
		Parent = box,
	})

	local hit = create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Parent = box,
	})

	local list = create("Frame", {
		Size = UDim2.new(1, 0, 0, #options * rowHeight),
		Position = UDim2.fromOffset(0, 36),
		BackgroundColor3 = THEME.Box,
		BorderSizePixel = 0,
		Visible = false,
		Parent = frame,
	}, { stroke(THEME.BoxBorder, 1) })

	local optionButtons = {}
	local object = {}

	local function refreshOptions()
		for choice, button in pairs(optionButtons) do
			button.TextColor3 = (choice == selected) and THEME.Accent or THEME.Text
		end
	end

	function object:Set(choice, silent)
		selected = choice
		valueLabel.Text = tostring(choice)
		refreshOptions()
		if not silent then
			task.spawn(callback, choice)
		end
	end

	function object:Get()
		return selected
	end

	for index, choice in ipairs(options) do
		local optionButton = create("TextButton", {
			Size = UDim2.new(1, 0, 0, rowHeight),
			Position = UDim2.fromOffset(0, (index - 1) * rowHeight),
			BackgroundTransparency = 1,
			Text = tostring(choice),
			TextColor3 = THEME.Text,
			Font = FONT,
			TextSize = TEXT_SIZE,
			TextXAlignment = Enum.TextXAlignment.Left,
			AutoButtonColor = false,
			Parent = list,
		}, { padding(0, 0, 6, 0) })
		optionButtons[choice] = optionButton

		optionButton.MouseButton1Click:Connect(function()
			object:Set(choice)
			open = false
			list.Visible = false
			plus.Text = "+"
			frame.Size = UDim2.new(1, 0, 0, 36)
		end)
	end
	refreshOptions()

	hit.MouseButton1Click:Connect(function()
		open = not open
		list.Visible = open
		plus.Text = open and "-" or "+"
		frame.Size = UDim2.new(1, 0, 0, open and (38 + #options * rowHeight) or 36)
	end)

	return object
end

-- Group:Label("text") -> :Set("new text")
function Group:Label(content)
	local label = text({
		Text = content,
		Size = UDim2.new(1, 0, 0, 14),
		TextColor3 = THEME.TextDim,
		LayoutOrder = nextOrder(self),
		Parent = self.Body,
	})

	return {
		Set = function(_, newText)
			label.Text = newText
		end,
	}
end

--------------------------------------------------------------------------------
-- shortcuts: skip groups / tabs and add elements straight to the tab or window
--------------------------------------------------------------------------------

for _, method in ipairs({ "Toggle", "Button", "Slider", "Dropdown", "Label" }) do
	Tab[method] = function(self, ...)
		local group = self:_defaultGroup()
		return group[method](group, ...)
	end
	Library[method] = function(self, ...)
		local tab = self:_defaultTab()
		return tab[method](tab, ...)
	end
end

return Library
