-- classes
--------------------------------------------------------------------------------

local Library = {}
Library.__index = Library

local Tab = {}
Tab.__index = Tab

local Group = {}
Group.__index = Group

local fpsValue, fpsConnection = 60, nil

-- Library.FPS() -> smoothed frames per second (handy for the watermark)
function Library.FPS()
	if not fpsConnection then
		fpsConnection = RunService.Heartbeat:Connect(function(dt)
			if dt > 0 then
				fpsValue = fpsValue * 0.9 + (1 / dt) * 0.1
			end
		end)
	end
	return math.floor(fpsValue + 0.5)
end

