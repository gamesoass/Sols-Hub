-- Tab:Group("Title", "left" | "right")  -- side is optional, it balances the columns
function Tab:Group(name, side)
	if side ~= "left" and side ~= "right" then
		side = (self._counts.left <= self._counts.right) and "left" or "right"
	end
	self._counts[side] += 1

	local group = setmetatable({}, Group)
	group.Tab = self
	group.Window = self.Window

	group.Frame = create("Frame", {
		Size = UDim2.new(1, 0, 0, 30),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Panel,
		BorderSizePixel = 0,
		LayoutOrder = self._counts[side],
		Parent = self.Columns[side],
	}, { stroke(THEME.PanelBorder, 1) })

	-- accent line along the top edge, interrupted by the title
	create("Frame", {
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundColor3 = THEME.Accent,
		BorderSizePixel = 0,
		Parent = group.Frame,
	})

	local title = text({
		Text = name,
		Size = UDim2.fromOffset(0, 14),
		AutomaticSize = Enum.AutomaticSize.X,
		Position = UDim2.fromOffset(8, -7),
		TextColor3 = THEME.Text,
		ZIndex = 2,
		Parent = group.Frame,
	})
	title.BackgroundTransparency = 0
	title.BackgroundColor3 = THEME.Panel
	create("UIPadding", { PaddingLeft = UDim.new(0, 3), PaddingRight = UDim.new(0, 3), Parent = title })

	group.Body = create("Frame", {
		Size = UDim2.fromScale(1, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Parent = group.Frame,
	}, {
		create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
		padding(12, 10, 8, 8),
	})

	return group
end

function Tab:_defaultGroup()
	if not self._default then
		self._default = self:Group("Main", "left")
	end
	return self._default
end

